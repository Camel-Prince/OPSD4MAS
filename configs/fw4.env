# Portable FW4 reference profile; environment variables override these values.
# These are public fresh-training settings, not a replay of the historical step-20 resume.
MODEL_PATH=data/models/Qwen3-4B
DATA_DIR=data/prepared
OUTPUT_ROOT=outputs
NUM_GPUS=4
SEED=35
TRAIN_BATCH_SIZE=32
GROUP_SIZE=8
VAL_BATCH_SIZE=16
VAL_GROUP_SIZE=4
MAX_LOOP_NUM=3
MAX_PROMPT_LENGTH=8192
MAX_RESPONSE_LENGTH=4096
MAX_TEACHER_CONTEXT_LENGTH=8192
ACTOR_MICRO_BATCH_SIZE=2
LOG_PROB_MICRO_BATCH_SIZE=8
PPO_EPOCHS=1
TOTAL_EPOCHS=2
TOTAL_TRAINING_STEPS=550
SAVE_FREQ=10
TEST_FREQ=10
FACT_FUTURE_WINDOW=4
FACT_MAX_FACTS_PER_COMMENT=12
FACT_MAX_CANDIDATES=10
FACT_MAX_SELECTED=8
FACT_LOO_VARIANT_BATCH_SIZE=32
FACT_MIN_EFFECT=0.02
FACT_MIN_PRECISION=0.50
FACT_MIN_NET_ALIGNMENT=-0.001
FACT_CONFLICT_WEIGHT=1.0
OPD_LOSS_WEIGHT_INIT=0.1
OPD_LOSS_WEIGHT_ANNEAL_RATE=0.0004
OPD_LOSS_WEIGHT_MIN=0.02
# No provider/tenant is assumed. Required at actual training launch.
OPSD_API_BASE_URL=
OPSD_API_MODEL=
OPSD_API_KEY_ENV=OPSD_API_KEY
OPSD_API_TPM=
OPSD_API_RPM=
OPSD_API_CONCURRENCY=
OPSD_API_MAX_TOKENS=4096
