# Copy to .env.local (ignored); load manually with `set -a; source .env.local; set +a`.
# Set values for your OpenAI-compatible JSON-capable endpoint. Do not put the key in configs/fw4.env.
OPSD_API_BASE_URL=https://your-provider.example/v1
OPSD_API_MODEL=your-json-capable-model
OPSD_API_KEY=replace-with-your-key
# Allocate this job's share of provider quota; include other processes/servers.
OPSD_API_TPM=100000
OPSD_API_RPM=30
OPSD_API_CONCURRENCY=2
